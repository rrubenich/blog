---
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/newsreader/500.css";
import "@fontsource/newsreader/600.css";
import "@fontsource/newsreader/700.css";
import "../styles/global.css";
import { SITE } from "../config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article" | "profile";
  reading?: boolean; // show reading controls (post pages)
  noindex?: boolean;
  image?: string; // path to a social preview image
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
}
const { title, description = SITE.description, type = "website", reading = false, noindex = false, image, imageWidth = 1200, imageHeight = 630, imageAlt } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.author}, ${SITE.tagline} | ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogPath = image ?? (SITE.features.ogImages ? "/og/default.png" : undefined);
const ogUrl = ogPath ? new URL(ogPath, Astro.site).href : undefined;
const siteUrl = new URL("/", Astro.site).href;
const gtmId = (import.meta.env.PUBLIC_GTM_ID ?? SITE.gtmId ?? "").trim();
// Only load GTM in production builds, so local previews don't count as visits.
const loadGtm = import.meta.env.PROD && /^GTM-[A-Z0-9]+$/.test(gtmId);

// Site-wide structured data: who writes this site and what it is.
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}#person`,
      name: SITE.author,
      alternateName: "Rafael Rübenich",
      url: new URL("/about/", Astro.site).href,
      image: new URL(SITE.photo, Astro.site).href,
      jobTitle: SITE.tagline,
      description: SITE.description,
      address: { "@type": "PostalAddress", addressLocality: "Vitória", addressRegion: "ES", addressCountry: "BR" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Universidade Estadual do Oeste do Paraná (Unioeste)", url: "https://www.unioeste.br" },
      knowsLanguage: ["pt-BR", "en", "es"],
      knowsAbout: ["Software engineering", "TypeScript", "React", "Node.js", "Python", "AI agents", "LangGraph", "Healthcare IT", "HL7", "FHIR", "System design"],
      sameAs: [...SITE.profiles.map((p) => p.href), `https://x.com/${SITE.twitter.replace("@", "")}`],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: SITE.title,
      description: SITE.description,
      inLanguage: SITE.lang,
      author: { "@id": `${siteUrl}#person` },
      publisher: { "@id": `${siteUrl}#person` },
    },
  ],
};
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    {loadGtm && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", gtmId);
      </script>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="author" href="/about/" />
    {SITE.profiles.map((p) => <link rel="me" href={p.href} />)}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content={String(imageWidth)} />}
    {ogUrl && <meta property="og:image:height" content={String(imageHeight)} />}
    {ogUrl && <meta property="og:image:alt" content={imageAlt ?? fullTitle} />}
    <meta name="twitter:card" content={ogUrl && imageWidth > imageHeight ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <slot name="head" />

    <!-- Runs before first paint so theme and reading preferences never flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var t = localStorage.getItem("theme");
          if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          d.dataset.theme = t;
          var r = JSON.parse(localStorage.getItem("reading") || "{}");
          if (r.size) d.dataset.size = r.size;
          if (r.width) d.dataset.width = r.width;
          if (r.font) d.dataset.font = r.font;
        } catch (e) {
          if (matchMedia("(prefers-color-scheme: dark)").matches) d.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    {loadGtm && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    )}
    {reading && <div class="inkline" aria-hidden="true"></div>}
    <a class="skip" href="#main">Skip to content</a>
    <Header reading={reading} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
