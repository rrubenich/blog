---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import BrandIcon from "../components/BrandIcon.astro";
import { SITE } from "../config";

// Company logos live in public/logos/. A missing file falls back to a monogram.
type Role = { title: string; dates: string };
type Job = {
  company: string;
  url: string;
  logo?: string;
  blurb: string;
  where: string;
  roles: Role[];
  highlights: string[];
};

const jobs: Job[] = [
  {
    company: "Luma Health",
    url: "https://www.lumahealth.io",
    logo: "/logos/luma-health.png",
    blurb: "US patient engagement platform used by 100M+ patients in the US, UK and Canada",
    where: "San Francisco Bay Area · Remote",
    roles: [
      { title: "Software Engineering Manager (hands-on)", dates: "Jan 2026 – Sep 2026" },
      { title: "Senior Software Engineer", dates: "Aug 2022 – Sep 2026" },
    ],
    highlights: [
      "Led Luma's first go-live in Canada: the ER Queue Manager at Sault Area Hospital, now the flagship Canadian reference.",
      "Migrated three high-traffic conversational agents to the new Agent Core platform with canary, per-account rollouts and CI voice tests.",
      "Architected the Luma Spark skills builder, where healthcare clients configure their own AI agents.",
      "Built a unified check-in platform (kiosk, QR code and URL) end to end in 4 days with AI-assisted development. The previous version took a team about two months.",
      "Took the real-time communication Hub from beta to GA, and cut a flagship page load from 4.4s to 0.6s.",
      "Took Insights Center, the patient-journey analytics product, from event model to public launch, and led the next-gen UI rollout across five product pods.",
    ],
  },
  {
    company: "iFood",
    url: "https://www.ifood.com.br",
    logo: "/logos/ifood.png",
    blurb: "Brazil's largest food delivery platform",
    where: "São Paulo · Remote",
    roles: [{ title: "Senior Software Engineer, Tech Lead", dates: "Dec 2020 – May 2022" }],
    highlights: [
      "Architected a CRM that gives 250,000 restaurant partners daily analytics about their business and customers.",
      "Built the front-end infrastructure behind 30 million targeted vouchers in a single year.",
      "Set up mentorship programs for junior and mid-level engineers.",
    ],
  },
  {
    company: "Olist",
    url: "https://olist.com",
    logo: "/logos/olist.png",
    blurb: "One of Brazil's leading e-commerce ecosystems",
    where: "Curitiba · Remote",
    roles: [{ title: "Senior Software Engineer", dates: "Oct 2020 – Dec 2020" }],
    highlights: ["Designed a micro-frontends architecture to let teams ship the Olist web platform independently."],
  },
  {
    company: "TOTVS",
    url: "https://www.totvs.com",
    logo: "/logos/totvs.png",
    blurb: "Latin America's largest enterprise software company (joined via Wealth Systems)",
    where: "Cascavel, Paraná",
    roles: [
      { title: "Staff Engineer", dates: "Apr 2020 – Oct 2020" },
      { title: "Senior Software Engineer", dates: "Sep 2018 – Apr 2020" },
      { title: "Software Engineer", dates: "Sep 2016 – Aug 2018" },
    ],
    highlights: [
      "Built a design system that cut development time by up to 90% on most application pages.",
      "Turned a 240,000-line JavaScript codebase into a modular framework that new products were built on.",
      "Shipped SPAs, Java microservices and offline-first React Native apps; mentored engineers through development plans.",
    ],
  },
];

// Internships during the Computer Science degree at Unioeste.
const internships: Job[] = [
  {
    company: "Itaipu Binacional",
    url: "https://www.itaipu.gov.br",
    logo: "/logos/itaipu-binacional.png",
    blurb: "The binational hydroelectric plant on the Brazil–Paraguay border",
    where: "Foz do Iguaçu, Paraná",
    roles: [{ title: "Software Engineer Intern", dates: "Mar 2015 – Jan 2016" }],
    highlights: ["Developed and maintained internal administrative systems on IBM Lotus Notes and Java."],
  },
  {
    company: "Itaipu Parquetec",
    url: "https://www.itaipuparquetec.org.br",
    logo: "/logos/itaipu-parquetec.png",
    blurb: "Science and technology park at the Itaipu dam",
    where: "Foz do Iguaçu, Paraná",
    roles: [{ title: "Software Researcher Intern", dates: "Apr 2014 – Mar 2015" }],
    highlights: [
      "Researched augmented reality for dam safety and tourism with Unioeste professors and the Center for Advanced Studies in Dam Safety (CEASB).",
      "Helped build SIGATI, a georeferenced information system for Itaipu tourism, with JavaScript, Wikitude, Ionic and AngularJS.",
    ],
  },
];

const projects = [
  {
    name: "platform-base",
    href: "https://github.com/rrubenich/platform-base",
    text: "A multi-tenant foundation for AI products: auth, organizations and teams, an admin console, and an agents platform with streaming chat, background jobs and agent-to-agent delegation.",
    stack: "NestJS · React 19 · Python · LangGraph",
  },
  {
    name: "genetic-dna",
    href: "https://github.com/rrubenich/genetic-dna",
    extra: { label: "Model on Hugging Face", href: "https://huggingface.co/rubenich/genetic-dna-tiny" },
    text: "A small DNA language model trained from scratch, growing into an API and an MCP server over public genomics databases.",
    stack: "Python · Hugging Face · PyTorch",
  },
  {
    name: "blog",
    href: "https://github.com/rrubenich/blog",
    text: "This site. Astro, deployed to Cloudflare Workers on every push.",
    stack: "Astro · TypeScript · Cloudflare",
  },
];

const skills = [
  { group: "Product", items: ["TypeScript", "React", "Next.js", "Node.js", "NestJS", "GraphQL", "React Native"] },
  { group: "AI", items: ["LangGraph", "LangChain", "OpenAI & Anthropic APIs", "MCP", "Python", "FastAPI", "Temporal"] },
  { group: "Data & infra", items: ["PostgreSQL", "Redis", "MongoDB", "AWS", "Kubernetes", "Docker", "Terraform", "Datadog"] },
  { group: "Healthcare", items: ["Epic", "Oracle Cerner", "MEDITECH", "NextGen", "HL7", "FHIR", "HIPAA"] },
];

const cbc =
  "https://www.cbc.ca/news/canada/new-brunswick/new-brunswick-emergency-room-wait-home-text-pilot-ontario-9.7038870";
const profileLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: new URL("/about/", Astro.site).href,
  mainEntity: {
    "@id": new URL("/#person", Astro.site).href,
    "@type": "Person",
    name: SITE.author,
    hasOccupation: { "@type": "Occupation", name: SITE.tagline, skills: "TypeScript, React, Node.js, Python, LLM agents, healthcare interoperability" },
    alumniOf: [{ "@type": "CollegeOrUniversity", name: "Universidade Estadual do Oeste do Paraná (Unioeste)" }],
    affiliation: jobs.map((j) => ({ "@type": "Organization", name: j.company, url: j.url })),
  },
};
const hasFile = (src?: string) => !!src && fs.existsSync(path.join(process.cwd(), "public", src));
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase();
---

<Base
  title={`About ${SITE.author}, ${SITE.tagline}`}
  description={`${SITE.author} is a senior full-stack software engineer with 10+ years in TypeScript, React and Node.js, building healthcare and AI products at Luma Health, iFood and TOTVS.`}
  type="profile"
  image={SITE.photo}
  imageWidth={900}
  imageHeight={1200}
  imageAlt={`Photo of ${SITE.author}`}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(profileLd)} />
  <meta slot="head" property="profile:first_name" content="Rafael" />
  <meta slot="head" property="profile:last_name" content="Rubenich" />
  <article class="article about">
    <header class="article-head">
      <img class="about-photo" src="/rafael-rubenich-200.jpg" srcset="/rafael-rubenich-200.jpg 1x, /rafael-rubenich-400.jpg 2x" alt={`${SITE.author} in front of the Eiffel Tower`} width="200" height="266" fetchpriority="high" />
      <h1>Hi, I'm Rafael Rubenich.</h1>
      <p class="lede">
        I'm a senior full-stack engineer with 10+ years in TypeScript, React and Node.js, and lately a lot of Python and
        LLM agents. I build software that makes health care easier to deal with, for patients and for the staff on the other
        side of the screen.
      </p>
      <div class="meta">
        <span>Vitória, Brazil</span>
        <span>Remote, US time-zone overlap, open to relocation</span>
        <span>Portuguese, English, Spanish</span>
      </div>
      <ul class="tags about-links">
        {SITE.profiles.map((p) => (
          <li><a href={p.href} rel="me noopener" target="_blank"><BrandIcon name={p.icon as "github" | "linkedin"} />{p.label}</a></li>
        ))}
        <li><a href="mailto:rfrubenich@gmail.com">rfrubenich@gmail.com</a></li>
      </ul>
    </header>

    <div class="prose">
      <p class="callout">
        <strong>Now:</strong> on a planned career break, going deeper into system design and AI agent engineering by
        building things in the open. I'm looking for my next hands-on Senior Software Engineer role.
      </p>

      <h2 id="highlight">Highlight</h2>
      <h3>A virtual ER waiting room, cited by a health minister</h3>
      <p class="about-note">CBC News · January 14, 2026</p>
      <p>
        I led Luma's first Canadian go-live: an emergency-department queue at Sault Area Hospital in Ontario that lets
        non-urgent patients wait at home and get a text when it's time to come in. During the three-month pilot, overall
        wait times fell by more than 25% and the share of patients leaving without being seen nearly halved. New
        Brunswick's health minister, Dr. John Dornan, singled the project out as a model his province should look at.
      </p>
      <p><a href={cbc} target="_blank" rel="noopener">Read the CBC story</a></p>

      <h2 id="experience">Experience</h2>
      {jobs.map((j) => (
        <section class="job">
          <a class="job-logo" href={j.url} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            {hasFile(j.logo) ? <img src={j.logo} alt="" width="48" height="48" loading="lazy" /> : <span>{initials(j.company)}</span>}
          </a>
          <div class="job-body">
            <h3><a href={j.url} target="_blank" rel="noopener">{j.company}</a></h3>
            <p class="about-note">{j.blurb} · {j.where}</p>
            <ul class="job-roles">
              {j.roles.map((r) => <li><span>{r.title}</span><time>{r.dates}</time></li>)}
            </ul>
            <ul>
              {j.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        </section>
      ))}

      <h2 id="internships">Internships</h2>
      {internships.map((j) => (
        <section class="job">
          <a class="job-logo" href={j.url} target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
            {hasFile(j.logo) ? <img src={j.logo} alt="" width="48" height="48" loading="lazy" /> : <span>{initials(j.company)}</span>}
          </a>
          <div class="job-body">
            <h3><a href={j.url} target="_blank" rel="noopener">{j.company}</a></h3>
            <p class="about-note">{j.blurb} · {j.where}</p>
            <ul class="job-roles">
              {j.roles.map((r) => <li><span>{r.title}</span><time>{r.dates}</time></li>)}
            </ul>
            <ul>
              {j.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </div>
        </section>
      ))}

      <h2 id="projects">What I'm building</h2>
      <ul>
        {projects.map((p) => (
          <li>
            <a href={p.href} target="_blank" rel="noopener"><strong>{p.name}</strong></a>: {p.text}{" "}
            {p.extra && <a href={p.extra.href} target="_blank" rel="noopener">{p.extra.label}</a>}
            <span class="about-note">{p.stack}</span>
          </li>
        ))}
      </ul>

      <h2 id="tools">Tools I reach for</h2>
      {skills.map((s) => (
        <Fragment>
          <h3>{s.group}</h3>
          <ul class="tags">{s.items.map((i) => <li><span>{i}</span></li>)}</ul>
        </Fragment>
      ))}

      <h2 id="education">Education</h2>
      <section class="job">
        <a class="job-logo" href="https://www.unioeste.br" target="_blank" rel="noopener" aria-hidden="true" tabindex="-1">
          {hasFile("/logos/unioeste.png") ? <img src="/logos/unioeste.png" alt="" width="48" height="48" loading="lazy" /> : <span>U</span>}
        </a>
        <div class="job-body">
          <h3><a href="https://www.unioeste.br" target="_blank" rel="noopener">Universidade Estadual do Oeste do Paraná (Unioeste)</a></h3>
          <ul class="job-roles">
            <li><span>B.Sc. in Computer Science</span><time>2011 – 2015</time></li>
          </ul>
          <ul>
            <li>Student representative for the Computer Science class of 2011.</li>
            <li>Member of the Computer Science Academic Center (CACC), 2012–2015.</li>
          </ul>
        </div>
      </section>
    </div>
  </article>
</Base>
