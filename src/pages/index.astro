---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { SITE } from "../config";
import { getPosts } from "../utils/posts";

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const others = posts.filter((p) => p !== featured);
const side = others.slice(0, SITE.postsOnHome);
const more = others.slice(SITE.postsOnHome, SITE.postsOnHome + SITE.morePostsOnHome);
---

<Base>
  {featured ? (
    <div class="wide home">
      <section class:list={["home-top", { solo: side.length === 0 }]} aria-label="Latest posts">
        <PostCard post={featured} variant="hero" />
        {side.length > 0 && (
          <div class="home-side">
            {side.map((p) => <PostCard post={p} variant="row" />)}
          </div>
        )}
      </section>
      {more.length > 0 && (
        <section class="home-more" aria-labelledby="more-title">
          <div class="home-more-head" data-area="home-more">
            <h2 id="more-title">More posts</h2>
            <a href="/posts">View all</a>
          </div>
          <div class="tiles">
            {more.map((p) => <PostCard post={p} variant="tile" />)}
          </div>
        </section>
      )}
    </div>
  ) : (
    <section class="col intro">
      <h1 class="page-title">Nothing here yet</h1>
      <p class="page-lede">Add a Markdown file to <code>src/content/posts/</code> and it will appear here.</p>
    </section>
  )}
</Base>
