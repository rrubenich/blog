---
import { SITE } from "../config";
import ReadingMode from "./ReadingMode.astro";
import BrandIcon from "./BrandIcon.astro";

const { reading = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || (href !== "/" && path.startsWith(href + "/"));
---

<header class="site-header">
  <div class="masthead">
    <a class="mark-link" data-area="header-logo" href="/" aria-label={`${SITE.title} home`}>
      <svg class="mark" viewBox="0 0 30 24" aria-hidden="true"><path d="M3 12h24" stroke="var(--line)" stroke-width="3" stroke-linecap="round" /><path d="M3 12h15" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" /></svg>
    </a>
    <a class="brand" data-area="header-logo" href="/">{SITE.title}</a>
    <span class="tools" data-area="header-tools">
      {SITE.profiles.map((p) => (
        <a class="icon-btn" href={p.href} aria-label={p.label} rel="me noopener" target="_blank">
          <BrandIcon name={p.icon as "github" | "linkedin"} />
        </a>
      ))}
      {SITE.features.search && (
        <a class="icon-btn" href="/search" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        </a>
      )}
      {SITE.features.readingMode && reading && <ReadingMode />}
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </span>
  </div>
  <nav class="site-nav" aria-label="Main" data-area="header-nav">
    {SITE.nav.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>)}
  </nav>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch {}
    (window as unknown as { dataLayer?: object[] }).dataLayer?.push({ event: "theme_change", theme: next });
  });
</script>
