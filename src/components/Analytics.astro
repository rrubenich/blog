---
// Sends interaction events to the GTM dataLayer. GTM forwards them to GA4.
// Events: link_click, search, read_complete, theme_change, copy_code.
// Click areas come from the nearest [data-area] attribute in the page markup.
---

<script>
  type Params = Record<string, string | number>;
  const w = window as unknown as { dataLayer?: object[] };
  const track = (event: string, params: Params = {}) => (w.dataLayer ??= []).push({ event, ...params });
  (window as unknown as { rbTrack: typeof track }).rbTrack = track;

  const clean = (s: string | null | undefined) => (s ?? "").replace(/\s+/g, " ").trim().slice(0, 100);

  document.addEventListener("click", (e) => {
    const a = (e.target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
    if (!a) return;
    const url = new URL(a.href, location.href);
    const type = url.protocol === "mailto:" ? "email" : url.host === location.host ? "internal" : "external";
    const text =
      clean(a.dataset.label) ||
      clean(a.getAttribute("aria-label")) ||
      clean(a.querySelector(".feature-title, .work-title, .card-title, .t, h3")?.textContent) ||
      clean(a.textContent) ||
      clean(a.closest(".card")?.querySelector(".card-title")?.textContent) ||
      clean(a.querySelector("img")?.getAttribute("alt"));
    track("link_click", {
      link_area: (a.closest("[data-area]") as HTMLElement | null)?.dataset.area ?? "page",
      link_text: text,
      link_url: type === "email" ? "mailto" : url.origin + url.pathname,
      link_type: type,
    });
  });
</script>
